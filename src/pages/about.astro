---
import Content from '~/components/widgets/Content.astro';
import Steps from '~/components/widgets/Steps.astro';
import Layout from '~/layouts/PageLayout.astro';
import portraitImage from '~/assets/images/markus-smet-seated.jpg';

const metadata = {
  title: 'About',
};
---

<Layout metadata={metadata}>
  <!-- Content Widget **************** -->

  <Content
    id="about"
    image={{
      src: portraitImage,
      alt: 'Markus Smet',
      loading: 'eager',
      width: 500,
      height: 750,
    }}
  >
    <Fragment slot="content">
      <p class="text-base text-green-700 dark:text-green-300 font-bold tracking-wide uppercase mb-2">About</p>
      <h1 class="text-3xl font-bold tracking-tight dark:text-white sm:text-4xl mb-4">
        Product & Service Delivery Expert With Deep Psychological Understanding of Groups
      </h1>
      <p class="text-muted dark:text-slate-400">
        I hold a Masters in Coaching and Supervision focused on the human dynamics of organisations, the point where
        conscious meets unconscious behaviour. Left unattended, that gap turns ambitious plans into guesswork.
      </p>
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-page-2 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- Steps Widget ****************** -->

  <Steps
    id="experience"
    title="Work experience"
    items={[
      {
        title:
          'Psychological Training <br /> <span class="font-normal">Personal & Psychoanalytic Studies (Part-Time)</span> <br /> <span class="text-sm font-normal">7 years</span>',
        description: `A combination of extended group work, individual analysis, and academic study to understand human behavior and unconscious processes.`,
        icon: 'tabler:school',
      },
      {
        title:
          'Supervisory Board Member<br /> <span class="font-normal">Subject:Resoul Organisational Development Consultancy</span> <br /> <span class="text-sm font-normal">6 years</span>',
        description: `Supporting an award winning organisational development consultancy in a supervisory role.`,
        icon: 'tabler:briefcase',
      },
      {
        title:
          'Board Level Leader<br /> <span class="font-normal">Spreadshirt, Flaconi, Brandwatch, Ninox</span> <br /> <span class="text-sm font-normal">12 years</span>',
        description: `Led Product and Design teams at multiple high-growth tech companies through significant scaling phases. Managing teams of up to 25 people. Overseeing product strategy, establishing agile, design, research and product operations.`,
        icon: 'tabler:briefcase',
      },
    ]}
    classes={{ container: 'max-w-3xl' }}
  />

  <!-- Steps Widget ****************** -->

  <Steps
    id="education"
    title="Education"
    items={[
      {
        title: `Master of Arts Psychoanalytic Leadership & Consulting<br /> <span class="font-normal">Berlin's International Psychoanalytic University</span> <br /> <span class="text-sm font-normal">2024 - 2027</span>`,
        icon: 'tabler:school',
      },
      {
        title: `Bachelor of Arts with Honours International Business Studies<br /> <span class="font-normal">Leeds' Metropolitan University</span> <br /> <span class="text-sm font-normal">1991 - 1995</span>`,
        icon: 'tabler:school',
      },
    ]}
    classes={{ container: 'max-w-3xl' }}
  />
</Layout>
