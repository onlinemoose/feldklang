---
import Layout from '~/layouts/PageLayout.astro';
import Header from '~/components/widgets/Header.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import Booking from '~/components/widgets/Booking.astro';

import { headerData } from '~/navigation';

const metadata = {
  title: 'Book an Exploratory Call',
  robots: {
    index: false,
    follow: false,
  },
};
---

<Layout metadata={metadata}>
  <Fragment slot="header">
    <Header {...headerData} isSticky />
  </Fragment>

  <!-- HeroText Widget ******************* -->

  <HeroText
    tagline="Get Started"
    title="Book an Exploratory Call"
    subtitle="Pick a time that works for you. We'll spend 30 minutes exploring where you're stuck and whether working together makes sense."
  />

  <!-- Booking Widget ******************* -->

  <Booking id="booking" />
</Layout>
