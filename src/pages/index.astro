---
import Layout from '~/layouts/PageLayout.astro';

import Header from '~/components/widgets/Header.astro';
import Hero from '~/components/widgets/Hero.astro';
import Content from '~/components/widgets/Content.astro';
import Brands from '~/components/widgets/Brands.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
// import Features3 from '~/components/widgets/Features3.astro';
// import Testimonials from '~/components/widgets/Testimonials.astro';
import Features2 from '~/components/widgets/Features2.astro';
import BlogLatestPosts from '~/components/widgets/BlogLatestPosts.astro';
import Image from '~/components/common/Image.astro';
import Button from '~/components/ui/Button.astro';
import heroImage from '~/assets/images/human-dynamics-hero.png';
import aboutPhoto from '~/assets/images/markus-smet.jpg';
import workCounsellingImage from '~/assets/images/work_counselling.jpg';
import groupSupervisionImage from '~/assets/images/group_supervision.jpg';
import organisationalDevelopmentImage from '~/assets/images/organisational_development.jpg';
import organisationalDisturbanceImage from '~/assets/images/organisational_disturbance.jpg';
import yellLogo from '~/assets/images/logos/yell.svg';
import skyLogo from '~/assets/images/logos/sky.svg';
import brandwatchLogo from '~/assets/images/logos/brandwatch.png';
import ipuBerlinLogo from '~/assets/images/logos/ipu-berlin.svg';

const metadata = {
  title: 'Feldklang - Markus Smet Getting You To Lead Ambitious Teams',
  description:
    'Get ahead by attending to the human dynamics of ambitious work: coaching, supervision and organisational development with Markus Smet.',
  openGraph: {
    images: [
      {
        url: '~/assets/images/home-og.png',
        width: 1200,
        height: 628,
      },
    ],
  },
};
---

<Layout metadata={metadata}>
  <Fragment slot="announcement"></Fragment>
  <Fragment slot="header">
    <Header
      links={[
        { text: 'Home', href: '/' },
        { text: 'About', href: '/about' },
        { text: 'Services', href: '#services' },
        // { text: 'Testimonials', href: '#testimonials' },
        { text: 'Blog', href: '/blog' },
      ]}
      actions={[
        {
          text: 'Book a call',
          href: '/book-exploratory-call',
          // See navigation.ts for why this forces a full page load.
          'data-astro-reload': true,
        },
      ]}
      isSticky
    />
  </Fragment>

  <!-- Hero2 Widget ******************* -->

  <Hero
    id="hero"
    title="Build An Ambitious Mindset"
    tagline=""
    actions={[{ variant: 'primary', text: 'Why?', href: '#mindset' }]}
  >
    <Fragment slot="subtitle">
      <span class="hero-subtitle-text"> Get ahead. Attend to the <i>human dynamics</i> of ambitious work. </span>
    </Fragment>

    <Fragment slot="bg">
      <Image
        src={heroImage}
        alt=""
        loading="eager"
        layout="fullWidth"
        widths={[400, 768, 1145]}
        sizes="(max-width: 767px) 400px, (max-width: 1023px) 768px, 1145px"
        class="absolute inset-y-0 right-0 max-w-none opacity-30 dark:opacity-20"
        style="width: auto; height: 100%; object-fit: contain; object-position: right center; mask-image: linear-gradient(to right, transparent, transparent 40%, black 75%); -webkit-mask-image: linear-gradient(to right, transparent, transparent 40%, black 75%);"
      />
    </Fragment>
  </Hero>

  <!-- Content Widget **************** -->

  <Content
    id="mindset"
    image={{
      src: aboutPhoto,
      alt: 'Image of Markus Smet',
      loading: 'eager',
    }}
  >
    <Fragment slot="content">
      <h2 class="text-2xl font-bold tracking-tight font-heading dark:text-white sm:text-3xl mb-2">
        Why Does Mindset Matter?
      </h2>
      <p>
        Over time I noticed my greatest career successes were not about the tangible processes, structures or strategy.
      </p>
      <br />
      <p>Success, and failure, amplifies when the dynamics between people work well, or poorly.</p>
      <br />
      <p class="mb-6">
        So shaping <b><i>people's experience of work</i></b> became my focus because I wanted to know how this worked, and
        how to do it better.
      </p>
      <div
        class="max-w-xs sm:max-w-md mx-auto md:mx-0 flex flex-nowrap flex-col sm:flex-row justify-center md:justify-start"
      >
        <div class="flex w-full sm:w-auto">
          <Button variant="primary" text="How?" href="#how" class="w-full sm:mb-0" />
        </div>
      </div>
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-page-2 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- Brands Widget ****************** -->

  <Brands
    title="Organisations I've Worked With"
    icons={[]}
    images={[
      { src: yellLogo, alt: 'Yell' },
      { src: skyLogo, alt: 'Sky' },
      { src: brandwatchLogo, alt: 'Brandwatch', height: 60 },
      { src: ipuBerlinLogo, alt: 'International Psychoanalytic University Berlin' },
    ]}
  />

  <!-- Features2 Widget ************** -->

  <Features2
    id="how"
    title="How To Shape People's Experience of Work"
    subtitle="You can do many things to help a team think for themselves. But for it to stick, so you don't have to keep pushing, this is how. "
    tagline="Ambition"
    columns={4}
    items={[
      {
        title: 'Align On Primary Task',
        description:
          'Clarity takes much longer than expected, early ideas and KPIs are often wrong. Keep the primary task in dialogue, this is not a one-time exercise.',
        icon: 'tabler:target-arrow',
      },
      {
        title: 'Entrust Role Holders',
        description:
          'More than a job description, a holder must mentally inhabit a profession, separate from their personal identity, and roles are equally supported by the team.',
        icon: 'tabler:users-group',
      },
      {
        title: 'Uphold Lively Discourse',
        description:
          'Build constructive behaviour that uses and tolerates plainly spoken truths over avoidance or threats, to help people process the tension of ambition.',
        icon: 'tabler:messages',
      },
      {
        title: 'Be A Brave Leader',
        description:
          'Work to stay on the same page, share struggles, listen and use power constructively. Why? To lower defensive behaviours, creating space for clarity.',
        icon: 'tabler:shield-check',
      },
    ]}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-green-50 dark:bg-green-950/30"></div>
    </Fragment>
  </Features2>

  <!-- Content Widget **************** Service 1 -->

  <Content
    id="services"
    title="Services"
    subtitle="Organisational consulting attending to the mindset of ambitious work"
    isReversed
    items={[
      {
        title: 'Why Do It:',
        icon: 'tabler:user',
        description:
          'Leading is complex, driving change and innovation is even more so. To be lead ambitiously without the downsides, you need to understand your own mindset and motivations.',
      },
      {
        title: 'How It Works:',
        icon: 'tabler:settings-question',
        description:
          "To leverage your potential, we explore not just what others are doing but also your impact on ambition. Gentle but honest exploration, room for you to find thoughts you haven't found words for until now. The reasons for hesitation or resistance will emerge and we will find concrete actions worth taking.",
      },
      {
        title: 'Format:',
        icon: 'tabler:question-mark',
        description:
          'One to one sessions, 60 minutes every 2-4 weeks to give time for thoughts to digest. Can be in person or remote depending on location.',
      },
    ]}
    image={{
      src: workCounsellingImage,
      alt: 'Coaching and Counselling',
    }}
    imageClasses="image-blur-diagonal"
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight font-heading dark:text-white sm:text-3xl mb-2">
        Leadership Coaching<br /><span class="text-2xl">For Leading Ambitiously</span>
      </h3>
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-page-2 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- Content Widget **************** Service 2 -->

  <Content
    id="group-supervision"
    isReversed
    items={[
      {
        title: 'Why Do It:',
        icon: 'tabler:user',
        description:
          'To create performance and build trust. Learn to speak plainly, collaborate better and develop more effective behavioural patterns in your team.',
      },
      {
        title: 'How It Works:',
        icon: 'tabler:settings-question',
        description:
          'Supervising a group means attending to the inter-personal dynamics so that learning from each other accelerates through constructive conflict, courage and inter-personal trust.',
      },
      {
        title: 'Format:',
        icon: 'tabler:question-mark',
        description:
          "Typically conducted in small groups with others facing similar demands. Commitment to 6 sessions over 6 months builds trust. You learn from each other's experience whilst developing genuine insight into your own practice.",
      },
    ]}
    image={{
      src: groupSupervisionImage,
      alt: 'Supervision',
    }}
    imageClasses="image-blur-diagonal"
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight font-heading dark:text-white sm:text-3xl mb-2">
        Supervision<br /><span class="text-2xl">Activate Teams So They Come Together</span>
      </h3>
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-page-2 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- Content Widget **************** Service 3 -->

  <Content
    id="org-development"
    isReversed
    items={[
      {
        title: 'Why Do It:',
        icon: 'tabler:user',
        description:
          'Proactively preempt problems, set up teams to work well together and build up a healthy organisational mindset.',
      },
      {
        title: 'How It Works:',
        icon: 'tabler:settings-question',
        description:
          'With interviews and observing the organisation at work patterns of anxiety, defenciveness and avoidance between teams, individuals, and leaders becomes visible. Combined with Supervision and Coaching, we can clarify company goals and see how values are upheld in teams.',
      },
      {
        title: 'Format:',
        icon: 'tabler:question-mark',
        description:
          '3 month engagement with 4 days p/month, starts with a 1 week assessment where initial issues are shared and focus is prioritised.',
      },
    ]}
    image={{
      src: organisationalDevelopmentImage,
      alt: 'Organisational Development',
    }}
    imageClasses="image-blur-diagonal-line"
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight font-heading dark:text-white sm:text-3xl mb-2">
        Organisational Development<br /><span class="text-2xl">Growing Organisational Ambition</span>
      </h3>
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-page-2 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- Content Widget **************** Service 4 -->

  <Content
    id="org-disruption"
    isReversed
    items={[
      {
        title: 'Why Do It:',
        icon: 'tabler:user',
        description:
          'Leaders seeking to strengthen organisational capability to process unwelcome customer truths that challenge and evolve the organisation.',
      },
      {
        title: 'How It Works:',
        icon: 'tabler:settings-question',
        description:
          'Individual and leadership team coaching to uncover risks and establish a clear goal. Build clear responsibilities to identify customer problems and bring them into the organisation. Provide group supervision for the team as they question established practice and push back on comfortable assumptions.',
      },
      {
        title: 'Format:',
        icon: 'tabler:question-mark',
        description: 'Initially onsite, follow up work and supervision possible remotely.',
      },
    ]}
    image={{
      src: organisationalDisturbanceImage,
      alt: 'Customer Led Innovation',
    }}
    imageClasses="image-blur-diagonal"
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight font-heading dark:text-white sm:text-3xl mb-2">
        Customer-Led Innovation<br /><span class="text-2xl">Bring the outside-in to the Organisation</span>
      </h3>
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-page-2 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- Testimonials Widget *********** 

  <Testimonials
    id="testimonials"
    title="Client testimonials"
    subtitle="Discover what clients have to say about their experiences working with me."
    testimonials={[
      {
        testimonial: `She took our vague concept and turned it into a visual masterpiece that perfectly aligned with our goals. Her attention to detail and ability to translate ideas into compelling visuals exceeded our expectations.`,
        name: 'Mark Thompson',
        job: 'Creative director',
        image: {
          src: 'https://images.unsplash.com/photo-1500648767791-00dcc994a43e?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=774&q=80',
          alt: 'Mark Thompson Image',
        },
      },
      {
        testimonial: `She transformed our brand identity with her creative finesse, capturing our essence in every element. Her dedication and talent truly shine through her work.`,
        name: 'Emily Martinez',
        job: 'CEO',
        image: {
          src: 'https://images.unsplash.com/photo-1554151228-14d9def656e4?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=772&q=80',
          alt: 'Emily Martinez Image',
        },
      },
      {
        testimonial: `She has an uncanny ability to communicate emotions and stories. She crafted a logo for our NGO that not only represents our cause but also evokes empathy. Her professionalism and commitment make her a designer of exceptional caliber.`,
        name: 'Laura Simmons',
        job: 'Founder of an NGO',
        image: {
          src: 'https://images.unsplash.com/photo-1554727242-741c14fa561c?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=774&q=80',
          alt: 'Laura Simmons Image',
        },
      },
    ]}
  />

  -->

  <!-- CallToAction Widget *********** -->

  <CallToAction
    title="Build An Ambitious Mindset"
    subtitle="For a mindset that goes beyond normal, let's talk."
    actions={[
      {
        variant: 'primary',
        text: 'Book a call',
        href: '/book-exploratory-call',
        // See navigation.ts for why this forces a full page load.
        'data-astro-reload': true,
      },
    ]}
  />

  <!-- BlogLatestPost Widget **************** -->

  <BlogLatestPosts
    id="blog"
    title="Explore insightful articles on my blog"
    information={`Dive into articles making psychoanalysis accessible, where you'll find invaluable insights, practical advice, and captivating narratives that reveal the power of unconscious processes.`}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-page-2 dark:bg-transparent"></div>
    </Fragment>
  </BlogLatestPosts>
</Layout>

<style>
  /* On narrow screens the hero illustration is pinned to the right edge but
     renders wider than the viewport, so it overflows to the left — the part
     that's actually visible sits behind the full-width text column. The
     bold title and the (already opaque) button hold up fine against it, but
     the lighter-weight subtitle needs help. Rather than a full-width panel
     behind the whole text block, this highlights just the subtitle's own
     wrapped lines, so the title and button keep more of the image showing
     through around them. Desktop already reads cleanly without this, so
     it's scoped to mobile only. */
  @media (max-width: 767px) {
    :global(#hero .hero-subtitle-text) {
      display: inline;
      box-decoration-break: clone;
      -webkit-box-decoration-break: clone;
      background: var(--aw-color-bg-page);
      background: color-mix(in srgb, var(--aw-color-bg-page) 85%, transparent);
      border-radius: 0.4em;
      padding: 0.2em 0.5em;
    }
  }

  /* A little extra breathing room in the hero specifically on the homepage,
     without changing the Hero widget's default height on every other page
     that uses it. */
  :global(#hero .py-12) {
    padding-top: 4rem;
    padding-bottom: 4rem;
  }
  @media (min-width: 768px) {
    :global(#hero .py-12) {
      padding-top: 6.5rem;
      padding-bottom: 6.5rem;
    }
  }
</style>
